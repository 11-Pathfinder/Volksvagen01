# =============================================================================
# VW Used Car Price Monitor - Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- VW Scraper Settings ---
VW_POSTCODE=SW1A 1AA         # Your UK postcode for location-based search
VW_RADIUS_MILES=50            # Search radius in miles
VW_MAX_PAGES=10               # Max pages to scrape (more pages = slower)

# Optional filters (leave blank to include all)
VW_MAX_PRICE=                 # e.g. 25000
VW_MAX_MILEAGE=               # e.g. 50000
VW_MIN_YEAR=                  # e.g. 2020
VW_MODELS=id.4,id.5           # Comma-separated, e.g. golf,polo,tiguan

# --- AutoTrader Comparison ---
AT_POSTCODE=                  # Defaults to VW_POSTCODE if blank

# --- Email Settings ---
# For Gmail: use an App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your.email@gmail.com
EMAIL_TO=your.email@gmail.com  # Comma-separated for multiple recipients
